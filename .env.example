# Environment, application and Supabase URLs are pinned in each Wrangler config.
# The following values remain separately configured in each Worker dashboard.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
STRIPE_PRICE_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_ANNUAL=price_REPLACE_ME
# Encrypted secrets: SUPABASE_SECRET_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET.
# Staging requires test-mode Stripe credentials; production requires live-mode.
# Do not copy secret values between environments or commit them.
